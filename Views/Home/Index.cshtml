@{
    ViewData["Title"] = "Mr Biggs";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Portfolio</title>
    <style>
            /* Base Reset & Variables */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            :root {
                --bg-color: #f8f9fa;
                --text-color: #333333;
                --accent-color: #0070f3;
                --card-bg: #ffffff;
                --border-color: #e2e8f0;
            }

            body {
                background-color: var(--bg-color);
                color: var(--text-color);
                line-height: 1.6;
                padding: 2rem 1rem;
            }

            /* Layout Container */
            .container {
                max-width: 800px;
                margin: 0 auto;
            }

            /* Header Section */
            header {
                text-align: center;
                margin-bottom: 3rem;
            }

                header h1 {
                    font-size: 2.5rem;
                    color: #111;
                    margin-bottom: 0.5rem;
                }

                header p {
                    font-size: 1.2rem;
                    color: #666;
                }

            /* Section Styling */
            section {
                margin-bottom: 3rem;
            }

            h2 {
                font-size: 1.5rem;
                border-bottom: 2px solid var(--border-color);
                padding-bottom: 0.5rem;
                margin-bottom: 1.5rem;
                color: #111;
            }

            /* Project Cards Grid */
            .projects-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                gap: 1.5rem;
            }

            .project-card {
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: 8px;
                padding: 1.5rem;
                transition: transform 0.2s, box-shadow 0.2s;
            }

                .project-card:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
                }

                .project-card h3 {
                    margin-bottom: 0.5rem;
                    color: #111;
                }

                .project-card p {
                    font-size: 0.95rem;
                    color: #555;
                    margin-bottom: 1rem;
                }

            .project-link {
                color: var(--accent-color);
                text-decoration: none;
                font-weight: 600;
                font-size: 0.9rem;
            }

                .project-link:hover {
                    text-decoration: underline;
                }

            /* Skills Tags */
            .skills-list {
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem;
            }

            .skill-tag {
                background-color: var(--card-bg);
                border: 1px solid var(--border-color);
                padding: 0.4rem 0.8rem;
                border-radius: 20px;
                font-size: 0.9rem;
                color: #555;
            }

            /* Contact Details */
            .contact-info p {
                margin-bottom: 0.5rem;
            }

            .contact-info a {
                color: var(--accent-color);
                text-decoration: none;
            }

                .contact-info a:hover {
                    text-decoration: underline;
                }

            /* Footer */
            footer {
                text-align: center;
                margin-top: 4rem;
                font-size: 0.85rem;
                color: #888;
            }
    </style>
</head>
<body>

    <div class="container">
        <!-- Profile Header -->
        <header>
            <h1>Your Name</h1>
            <p>Web Developer & Designer</p>
        </header>

        <!-- About Me Section -->
        <section id="about">
            <h2>About Me</h2>
            <p>Hello! I am a passionate creator focused on building clean, user-friendly digital experiences. I enjoy solving complex problems and turning ideas into functional reality through clean code.</p>
        </section>

        <!-- Projects Grid Section -->
        <section id="projects">
            <h2>Projects</h2>
            <div class="projects-grid">

                <!-- Project 1 -->
                <div class="project-card">
                    <h3>Project One</h3>
                    <p>A brief description of your awesome application, explaining what problem it solves and what tools you used.</p>
                    <a href="#" class="project-link">View Project &rarr;</a>
                </div>

                <!-- Project 2 -->
                <div class="project-card">
                    <h3>Project Two</h3>
                    <p>A brief description of your awesome application, explaining what problem it solves and what tools you used.</p>
                    <a href="#" class="project-link">View Project &rarr;</a>
                </div>

                <!-- Project 3 -->
                <div class="project-card">
                    <h3>Project Three</h3>
                    <p>A brief description of your awesome application, explaining what problem it solves and what tools you used.</p>
                    <a href="#" class="project-link">View Project &rarr;</a>
                </div>

            </div>
        </section>

        <!-- Core Skills Section -->
        <section id="skills">
            <h2>Skills</h2>
            <div class="skills-list">
                <span class="skill-tag">HTML5</span>
                <span class="skill-tag">CSS3</span>
                <span class="skill-tag">JavaScript</span>
                <span class="skill-tag">Git & GitHub</span>
                <span class="skill-tag">Responsive Design</span>
                <span class="skill-tag">UI/UX Layouts</span>
            </div>
        </section>

    </div>

</body>
</html>

    
