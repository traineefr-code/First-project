@model WebApplication1.Models.ContactDetails

@{
    ViewData["Title"] = "Contact Details";
}

<h1>Contact Details:</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">First Name:</dt>
        <dd class="col-sm-10">@Model.FirstName</dd>
        <dt class="col-sm-2">Last Name:</dt>
        <dd class="col-sm-10">@Model.LastName</dd>
        <dt class="col-sm-2">Email Address:</dt>
        <dd class="col-sm-10">@Model.Email</dd>
        <dt class="col-sm-2">Comment:</dt>
        <dd class="col-sm-10">@Model.Message</dd>
    </dl>
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
</p>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
