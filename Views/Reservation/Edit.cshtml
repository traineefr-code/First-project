@model WebApplication1.Models.ReservationDetails

@{
    ViewData["Title"] = "Edit Reservation";
}

<h1>Edit Reservation Details:</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <!-- same fields as Create -->
    <div class="form-group">
        <label asp-for="FirstName">First Name</label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="LastName">Last Name</label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Email">Email Address</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="R_Size">Reservation Size</label>
        <input asp-for="R_Size" class="form-control">
        <span asp-validation-for="R_Size" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="R_Date">Reservation Date</label>
        <input asp-for="R_Date" type="date" class="form-control">
        <span asp-validation-for="R_Date" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="R_Time">Reservation Time</label>
        <input asp-for="R_Time" type="time" class="form-control">
        <span asp-validation-for="R_Time" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}