@model WebApplication1.Models.ReservationDetails

@{
    ViewData["Title"] = "Reservation Details";
}

<h1>View Current Reservations:</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">First Name</dt>
        <dd class="col-sm-10">@Model.FirstName</dd>
        <dt class="col-sm-2">Last Name</dt>
        <dd class="col-sm-10">@Model.LastName</dd>
        <dt class="col-sm-2">Email Address</dt>
        <dd class="col-sm-10">@Model.Email</dd>
        <dt class="col-sm-2">Number of Guests</dt>
        <dd class="col-sm-10">@Model.R_Size</dd>
        <dt class="col-sm-2">Reservation Date</dt>
        <dd class="col-sm-10">@Model.R_Date</dd>
        <dt class="col-sm-2">Reservation Time</dt>
        <dd class="col-sm-10">@Model.R_Time</dd>
    </dl>
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</p>