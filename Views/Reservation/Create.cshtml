@model WebApplication1.Models.ReservationDetails

@{
    ViewData["Title"] = "Create Reservation";
}

<h1>Set a Reservation:</h1>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="FirstName">First Name:</label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="LastName">Last Name:</label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Email">Email Address:</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="R_Size">Number of Guests:</label>
        <input asp-for="R_Size" class="form-control">
        <span asp-validation-for="R_Size" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="R_Date">Reservation Date:</label>
        <input asp-for="R_Date" type="date" class="form-control">
        <span asp-validation-for="R_Date" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="R_Time">Reservation time:</label>
        <input asp-for="R_Time" type="time" class="form-control">
        <span asp-validation-for="R_Time" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}